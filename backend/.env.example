# Copy to .env

# Local anvil (default) or Sepolia
RPC_URL=http://127.0.0.1:8545
DEPLOYMENT=../blockchain/deployments/31337.json
# RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# DEPLOYMENT=../blockchain/deployments/11155111.json

# Pays gas to relay device reports. Use a dedicated low-value wallet, NOT the admin wallet.
RELAYER_PRIVATE_KEY=

PORT=4000
# Report window and sample interval pushed to devices. Each window = 1 on-chain tx.
WINDOW_SECONDS=60
SAMPLE_SECONDS=10
